<style type="text/css">
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Inter', 'Poppins', 'Segoe UI', sans-serif;
}
nav{
width: 100%;
height: 100px;
margin: 0;
position: fixed;
display: flex;
justify-content: space-between;
align-items: center;
background: white;
z-index: 1;
box-shadow: 0px 3px 10px #DCDCDC;
}
.outer {
  border: 2px solid black;   /* the outer frame */
  background-color: white;   /* the empty space you want */
  display: inline-block;     /* shrink to fit content */
  padding: 2px;        /* the “gap” around the inner rectangle */
  margin-left: 30px;
  /* FORM logo animation */
  opacity: 0;
  transform: translateY(20px);
  animation: logoIn 0.8s ease-out forwards;
  }
  
  @keyframes logoIn {
  to {
  opacity: 1;
  transform: translateY(0);
  }
}

.inner {
  background-color: black; /* the main rectangle */
  width: 90px;
  height: 38px;
  color: white;
  text-align: center;
  font-size: 35px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  }


.circle{
width: 45px;
height: 45px;
border-radius: 50%;
border: 2px solid black;

display: flex;
align-items: center;
justify-content: center;
}
.options{
display: flex;
gap: 10px;
margin-right: 20px;
}
.circle.menu{
background: black;
color: white;
}
.circle.share{
background: white;
color: black;

}
img {
width: 100%;
height: 230px;
margin-top: 100px;
object-fit: cover;
}
.hero{
position: relative;
}
.hero h1 {
  position: absolute;
  bottom: 100px;
  margin-left: 25px;
  font-size: 32px;
  letter-spacing: 4px;
  color: #fff;

  opacity: 0;
  transform: translateY(30px);
  animation: heroText 1s ease-out forwards;
  animation-delay: 0.3s;
}

@keyframes heroText {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.intro{
font-size: 25px;
margin: 20px;
padding: 10px;
word-spacing: 3px;
letter-spacing: 2px;
}
.fa-paper-plane {
  font-size: 23px;
}
.fa-bars{
font-size: 23px;
}
.body{
font-size: 20px;
margin: 20px;
margin-top: 36px;
padding: 10px;
word-spacing: 2px;
letter-spacing: 1px;
}
ul{
font-size: 20px;
margin: 17px;
}
li{
margin-bottom: 10px;
}
.quote {
padding: 8px;
padding-left: 25px;
font-size: 16px;
letter-spacing: 2px;
border-left: 2px solid deepskyblue;
background: #f9f9f9;
}
.help{
width: 100%;
height: 840px;
background: #F2F2F2;
color: black;
text-align: left;
}
.help h1{
font-size: 46px;
font-weight: 400;
margin-left: 27px;
padding-top: 50px;
}
.help p{
font-size: 10px;
padding: 10px;
margin: 19px;
margin-top: 2px;
}
.form{
  width: 90%;
  /* Add these lines to the .form selector */
  display: flex;
  flex-direction: column; /* Stack children vertically */
  align-items: center;    /* Center children horizontally */
}

input{
margin: 10px;
margin-left: 27px;
width: 80%;
height: 20px;
border: none;
border-bottom: 1px solid black;
background: #F2F2F2;

}
form h4{
margin-left: 27px;
margin-top: 10px;
padding-bottom: 15px;
font-weight: 300;
}
.submit{
width: 50px;
height: 50px;
border-radius: 50%;
border: none;
background: deepskyblue;
font-size: 12px;
text-align: center;
display: flex;
align-items: center;
justify-content: center;
  /* Remove the old fixed margin and just use a vertical margin */
  margin: 120px 0 20px 27px; /* Top: 120px, Left/Right: 0, Bottom: 20px */
  /* ... rest of the .submit styles ... */
}


.galary{
  width: 100%;
  /* Change fixed 'height' to flexible 'min-height' and set 'height: auto' */
  min-height: 50vh; /* Set a reasonable minimum height */
  height: auto;     /* Let content define the final height */
  background: white;
  margin: 0;
}

.galary img{
margin-top: 10px;;
width: 100%;
height: 220px;
}

footer{
width: 100%;
height: 130vh;
background: black;
}
footer p{
color: #D5D5D5;
padding: 20px;
margin-left: 20px;
font-size: 24px;
margin: 30px;
padding-bottom: 35px;
border-bottom: 0.1px solid #333;
}
footer ul{
color: #D5D5D5;
padding: 20px;
margin-left: 20px;
font-size: 24px;
margin: 30px;
padding-bottom: 35px;
border-bottom: 0.1px solid #333;
}

.right{
font-size: 15px;
text-align: center;
color: #888;
}

.outer.A{
border: 2px solid white;
background: black;
}
.inner.A{
background: white;
color: black;
}

footer h1{
color: white;
text-align: center;
font-size: 35px;

}

input:focus {
  outline: none;
  border-bottom: 2px solid deepskyblue;
  transition: border-bottom 0.25s ease;
  }
  .img-box {
  position: relative;
  overflow: hidden;
  height: 220px; /* match image height */
  }
  
  .img-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
  }
  
  .img-box::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
  opacity: 0;
  transition: opacity 0.4s ease;
  }
  
  .img-box h2 {
  position: absolute;
  bottom: 20px;
  left: 20px;
  color: white;
  font-size: 35px;
  letter-spacing: 3px;
  opacity: 1; /* visible by default */
  transform: translateY(0);
  transition: all 0.4s ease;
  }
  
  .img-box:hover img {
  transform: scale(1.08);
  }
  
  .img-box:hover::after {
  opacity: 1;
  }
  
  .img-box:hover h2 {
  /* optional hover animation if you want */
  transform: translateY(-5px);
  }
  

</style>
</head>
